{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kadence Media",
  "version": "0.1.0",
  "identifier": "dev.kadence.media",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Kadence Media",
        "url": "index.html?surface=host",
        "width": 1280,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "linux": { "deb": { "depends": ["mpv"] } },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
